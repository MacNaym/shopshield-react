{
  "name": "@shopshield/react",
  "version": "1.0.0",
  "description": "ShopShield cookie compliance banner for React and Lovable apps",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": ["gdpr", "cookie", "consent", "shopshield", "react", "lovable", "privacy"],
  "author": "RMP Foodworks s.r.l.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shopshield/react"
  }
}
